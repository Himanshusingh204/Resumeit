# Copy to .env
# AI provider: claude_cli | anthropic | openai | auto (auto = first one available)
AI_PROVIDER=auto
# claude_cli uses your logged-in Claude Code (no key needed). Set CLAUDE_BIN if `claude` is not on PATH.
CLAUDE_BIN=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
