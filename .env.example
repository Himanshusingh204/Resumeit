# Copy to .env (run.bat / run.sh does this for you the first time)

# ---- AI: the free option is Google Gemini ----------------------------------
# 1. Get a free key (Google account, no credit card): https://aistudio.google.com/apikey
# 2. Paste it after GEMINI_API_KEY= (no spaces, no quotes), save this file
# 3. Restart Resumeit. The label at the top of the page turns green and says Gemini.
# The free tier has daily limits, so build resumes for the jobs you really want.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# OpenCode CLI (npm i -g opencode-ai): free models, no key. Optional: OPENCODE_BIN, OPENCODE_MODEL (provider/model)
OPENCODE_MODEL=

# Which AI to use. auto = the first one that is set up (Claude Code, then an Anthropic key, an OpenAI key, a Gemini key).
# Set gemini to always use Gemini, even if you also have Claude Code installed.
# AI_PROVIDER: auto | gemini | claude_cli | anthropic | openai | opencode
AI_PROVIDER=auto

# ---- Other AI providers: optional, only if you already have one -------------
# Claude Code (already logged in) needs no key. Set CLAUDE_BIN if `claude` is not on PATH.
CLAUDE_BIN=
# Optional: model for Claude Code (e.g. a cheaper/faster one). Empty = its default.
CLAUDE_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ---- Server (127.0.0.1 / localhost only) ------------------------------------
HOST=127.0.0.1
PORT=8000
